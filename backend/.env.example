PORT=4000
# Comma-separated browser origins; set exact deployed origins in hosting settings.
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://ruta:ruta@localhost:5432/ruta?schema=public
# Generate a private random secret of at least 32 characters. Never commit real secrets.
AUTH_TOKEN_SECRET=replace-with-a-private-random-secret-at-least-32-characters

# Provider credentials belong only in local .env or the deployment secret store.
MTN_MOMO_BASE_URL=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
AIRTEL_MONEY_BASE_URL=
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
SMS_PROVIDER_BASE_URL=
SMS_PROVIDER_API_KEY=
