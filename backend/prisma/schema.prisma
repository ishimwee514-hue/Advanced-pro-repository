generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PASSENGER
  DRIVER
  AGENCY
  ADMIN
}

enum TripStatus {
  SCHEDULED
  BOARDING
  DEPARTED
  COMPLETED
  CANCELLED
}

enum TicketStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  phone            String?   @unique
  passwordHash     String
  role             UserRole  @default(PASSENGER)
  driverVehicles   Vehicle[] @relation("VehicleDriver")
  tickets          Ticket[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Vehicle {
  id        String   @id @default(cuid())
  plate     String   @unique
  model     String
  capacity  Int
  driverId  String?
  driver    User?    @relation("VehicleDriver", fields: [driverId], references: [id])
  trips     Trip[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Route {
  id            String   @id @default(cuid())
  origin        String
  destination   String
  distanceKm    Decimal? @db.Decimal(8, 2)
  durationMins  Int?
  baseFare      Decimal  @db.Decimal(10, 2)
  active        Boolean  @default(true)
  trips         Trip[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([origin, destination])
}

model Trip {
  id          String     @id @default(cuid())
  routeId     String
  vehicleId   String
  departureAt DateTime
  arrivalAt   DateTime?
  status      TripStatus @default(SCHEDULED)
  route       Route      @relation(fields: [routeId], references: [id])
  vehicle     Vehicle    @relation(fields: [vehicleId], references: [id])
  tickets     Ticket[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([departureAt, status])
}

model Ticket {
  id          String       @id @default(cuid())
  tripId      String
  passengerId String
  seatNumber  String
  fare        Decimal      @db.Decimal(10, 2)
  status      TicketStatus @default(PENDING)
  trip        Trip         @relation(fields: [tripId], references: [id])
  passenger   User         @relation(fields: [passengerId], references: [id])
  payment     Payment?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([tripId, seatNumber])
  @@index([passengerId, status])
}

model Payment {
  id            String        @id @default(cuid())
  ticketId      String        @unique
  provider      String
  providerRef   String?       @unique
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("RWF")
  status        PaymentStatus @default(PENDING)
  ticket        Ticket        @relation(fields: [ticketId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}
